# Copy to .env and fill in privately. Never commit .env.
# python-dotenv loads .env; existing process environment variables take precedence.
# Generate a private, stable random Flask session-signing key before using sessions.
SECRET_KEY=
MYSQL_HOST=
MYSQL_PORT=
MYSQL_DATABASE=careerly
MYSQL_USER=careerly_app
MYSQL_PASSWORD=
# Absolute path to the Aiven CA PEM file; forward slashes work on Windows.
MYSQL_SSL_CA=
# used by app.py (check line 49)
SECURE_COOKIES=0
# AI features (CAR-80): a Google Gemini API key from https://aistudio.google.com/apikey.
# Keep it private; never commit .env. Without a key the app runs and AI buttons are disabled.
# Free-tier content may be used by Google to improve its products: use sample CVs only on the free tier.
GEMINI_API_KEY=
# Optional: defaults to gemini-3.5-flash-lite; gemini-4-hydrogen is stronger but costs more.
GEMINI_MODEL=
