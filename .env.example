# Copy to .env and fill in privately. Never commit .env.
# python-dotenv loads .env; existing process environment variables take precedence.
# Generate a private, stable random Flask session-signing key before using sessions.
SECRET_KEY=
MYSQL_HOST=
MYSQL_PORT=
MYSQL_DATABASE=careerly
MYSQL_USER=careerly_app
MYSQL_PASSWORD=
# Absolute path to the Aiven CA PEM file; forward slashes work on Windows.
MYSQL_SSL_CA=
# used by app.py (check line 49)
SECURE_COOKIES=0
